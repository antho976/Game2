config_version=5

[application]
config/name="Game2"
run/main_scene="res://scenes/hub.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/use_custom_user_dir=true
config/custom_user_dir_name="Game2-hub-study"

[display]
window/size/viewport_width=1440
window/size/viewport_height=900
window/size/window_width_override=1440
window/size/window_height_override=900
window/stretch/mode="canvas_items"

[rendering]
anti_aliasing/quality/msaa_3d=2
environment/defaults/default_clear_color=Color(0.09,0.13,0.11,1)
lights_and_shadows/directional_shadow/size=4096

[physics]
common/physics_ticks_per_second=60
